+.contact-dialog :focus-visible{outline:3px solid #245e40;outline-offset:3px}
+.contact-dialog .contact-desc,.contact-help{color:#4d5b51}
+.foot{color:#a1aaa3}
+.hero h1 .dim{color:#8c9490}
+.contact h2 span{color:#919b95}
+.other-header h2{font-size:clamp(30px,4vw,49px);line-height:1.1;letter-spacing:-.06em;margin:0}
+.stack-categories h3{font-size:12px;color:var(--accent);font-weight:650;margin:0 0 14px}
+.case-placeholder{color:#b4bab6}
+@media(max-width:760px){
+  html{scroll-padding-top:90px;scroll-padding-bottom:95px}
+  .project-actions{width:100%}
+  .project-actions>*{width:100%;text-align:center;align-self:stretch}
+  .top-inner{gap:12px}
+  .menu-btn{min-width:44px;min-height:44px}
+  .hero h1{font-size:clamp(31px,8.5vw,64px)}
+  .hero{min-height:auto;gap:35px}
+  .hero-footer{padding-bottom:10px}
+  body.modal-open .mobile-contact{visibility:hidden}
+  .nav{max-height:calc(100svh - 160px);overflow:auto}
+  .contact-dialog,.project-quick-dialog{max-height:calc(100svh - 24px)}
+  .project-quick-inner{padding:22px}
+  .project-quick-dialog h2{font-size:34px}
+}
+@media(min-width:761px){.nav-cta{color:#111917!important}}
+@media(prefers-reduced-motion:reduce){
+  html{scroll-behavior:auto!important}
+  *,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}
+  .reveal.will-reveal:not(.visible){opacity:1;transform:none}
+}
