+/* Release candidate refinements, preserving the existing type, grid and palette. */
+:root{--sub:#989f9b}
+html{scroll-padding-top:110px;scrollbar-gutter:stable}
+body{overflow-wrap:break-word}
+.skip-link{position:fixed;top:8px;left:8px;z-index:200;background:#b7e7ce;color:#0b160e;padding:12px 20px;transform:translateY(-180%)}
+.skip-link:focus{transform:none}
+.reveal{opacity:1;transform:none}
+.reveal.will-reveal:not(.visible){opacity:0;transform:translateY(24px)}
+.reveal:focus-within{opacity:1!important;transform:none!important}
+.project-actions{display:flex;flex-direction:column;gap:10px;align-items:stretch;flex-shrink:0}
+.project-live,.live-status{display:inline-flex;align-items:center;justify-content:center;padding:12px 16px;border-radius:6px;line-height:1.5;font-size:13px;font-weight:650}
+.project-live{background:var(--accent,#b7e7ce);color:#102016;border:1px solid var(--accent,#b7e7ce)}
+.live-status{color:#aab4ad;background:#191e1b;border:1px dashed #56645b;font-weight:400;max-width:100%;text-align:left}
+.media-gallery{display:grid;gap:16px;margin:22px 0}
+.media-gallery figure{margin:0}
+.media-gallery img{display:block;width:100%;height:auto;border:1px solid #47554b;border-radius:7px;background:#111}
+.media-gallery figcaption,.media-pending{font-size:12px;line-height:1.6;color:#b4beb7;margin-top:9px}
+.media-gallery video{display:block;width:100%;max-height:65svh;background:#0c0d0f;border-radius:7px}
+.media-gallery a{color:var(--accent,#b7e7ce);text-decoration:underline;text-underline-offset:3px}
+.project-screenshot{width:100%;height:100%;object-fit:cover;object-position:top}
+.project-visual.has-screenshot{padding:0}
+.project-visual.has-screenshot::after{display:none}
+.project-quick-note{font-size:13px;line-height:1.7;color:#b5c2b9;border-left:2px solid #89b59a;padding:12px 16px;background:#202723}
+.project-quick-close,.contact-close{flex-shrink:0;min-width:44px;min-height:44px}
+.project-quick-top .kicker{margin:0}
